{
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/sso/accounts/token",    "destination": "/api/sso-handler?route=accounts/token" },
    { "source": "/api/sso/accounts/callback", "destination": "/api/sso-handler?route=accounts/callback" },
    { "source": "/api/sso/callback",          "destination": "/api/sso-handler?route=callback" },
    { "source": "/api/sso/me",                "destination": "/api/sso-handler?route=me" },
    { "source": "/api/sso/logout",            "destination": "/api/sso-handler?route=logout" },
    { "source": "/api/sso/otp/request",       "destination": "/api/sso-handler?route=otp/request" },
    { "source": "/api/sso/otp/verify",        "destination": "/api/sso-handler?route=otp/verify" },
    { "source": "/api/sso/profile/resume",    "destination": "/api/sso-handler?route=profile/resume" },
    { "source": "/api/sso/interviews/self-book-start", "destination": "/api/sso-handler?route=interviews/self-book-start" },
    { "source": "/api/sso/interviews/self-book", "destination": "/api/sso-handler?route=interviews/self-book" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    { "path": "/api/cron/generate-ai-reports", "schedule": "30 20 * * *" }
  ],
  "functions": {
    "api/cron/generate-ai-reports.js": { "maxDuration": 60 },
    "api/generate-ai-reports-bulk.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
