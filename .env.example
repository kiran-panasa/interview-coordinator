VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Secondary Firebase connection — ioe-admin-portal's own Firestore project,
# read/written directly via src/lib/ioeAdminPortalFirebase.js (separate from
# this app's own Firebase project above). Firestore-only — no messagingSenderId/appId needed.
VITE_IOE_ADMIN_PORTAL_API_KEY=
VITE_IOE_ADMIN_PORTAL_AUTH_DOMAIN=
VITE_IOE_ADMIN_PORTAL_PROJECT_ID=
VITE_IOE_ADMIN_PORTAL_STORAGE_BUCKET=

# Google Apps Script Web App — Calendar / Meet integration
VITE_APPS_SCRIPT_URL=
VITE_APPS_SCRIPT_SECRET=

# ── Server-only — for /api/* Vercel serverless functions ──────────────────
# Deliberately NOT prefixed with VITE_: those get inlined into the public
# client bundle. Set these in the Vercel dashboard (Project → Settings →
# Environment Variables), not in a browser-loaded .env.
#
# Full contents of a Firebase service account JSON key (Firebase Console →
# Project Settings → Service Accounts → Generate new private key). Paste the
# whole file's JSON as the value.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Shared secret the Academy app sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
ACADEMY_SYNC_API_TOKEN=
# Optional — restrict CORS to the Academy app's own origin instead of "*".
ACADEMY_APP_ORIGIN=
# Shared secret for the one-time admin backfill endpoints (safe to call
# more than once each): POST /api/admin/backfill-feedback-descriptors,
# POST /api/admin/backfill-candidate-uid, and
# POST /api/admin/backfill-program-info. Generate with: openssl rand -hex 32
FEEDBACK_BACKFILL_SECRET=
